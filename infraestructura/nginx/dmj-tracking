# Puerto 80: todo pasa a https (tracking.sekaidevec.com), también lo que llega
# por la IP. El panel y la app viajan cifrados.
# Copia en el servidor: /etc/nginx/sites-available/dmj-tracking

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://tracking.sekaidevec.com$request_uri; }
}
