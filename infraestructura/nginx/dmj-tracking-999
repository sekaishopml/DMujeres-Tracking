# Puerto 999: lo usan los teléfonos con versiones viejas de la app, que todavía
# no saben ir por https. Solo se atiende lo que ellos piden; el panel pasa a
# https (tracking.sekaidevec.com).
#   /api/mobile/      -> receptor de la app (5055)
#   latest.json y APK -> carpeta ota/ (actualizaciones de la app)
# Copia en el servidor: /etc/nginx/sites-available/dmj-tracking-999
server {
    listen 999;
    listen [::]:999;
    server_name _;

    client_max_body_size 10m;

    # Actualizaciones de la app
    location = /latest.json { root /home/DMujeres-Tracking/ota; }
    location = /rollout.json { root /home/DMujeres-Tracking/ota; }
    location ~ ^/DMujeres-Tracking-[0-9.]+\.apk$ { root /home/DMujeres-Tracking/ota; }

    # Lo que envía y consulta la app
    location /api/mobile/ {
        proxy_pass http://127.0.0.1:5055;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # El panel solo por https
    location / { return 301 https://tracking.sekaidevec.com$request_uri; }
}
