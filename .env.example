# Variables de DMujeres Tracking. Copiar a .env en la raíz del proyecto,
# llenar las claves y dejarlo con permisos 600. El .env nunca va a git.

# Base de datos (la usan el contenedor y los servicios)
POSTGRES_USER=dmt
POSTGRES_DB=dmujeres
POSTGRES_PASSWORD=cambiar-esta-clave
DMJ_DB_HOST=127.0.0.1
DMJ_DB_PORT=5443

# Canal de los teléfonos (servidor/tracking)
DMJ_TRACKING_HOST=0.0.0.0
DMJ_TRACKING_PORT=5055
DMJ_CANAL_MOVIL=1
DMJ_CLAVE_MOVIL=cambiar-esta-clave
# Solo mientras se cambia la clave: la anterior sigue valiendo.
DMJ_CLAVE_MOVIL_ANTERIOR=
DMJ_OTA_DIR=/home/DMujeres-Tracking/ota
# Duración de la sesión en el teléfono, en horas (720 = 30 días).
DMJ_SESION_MOVIL_HORAS=720

# API del panel (servidor/api)
DMJ_API_HOST=127.0.0.1
DMJ_API_PORT=8081
DMJ_SESION_HORAS=12
DMJ_ZONA_HORARIA=America/Guayaquil
DMJ_RUTEO_URL=http://127.0.0.1:8992

# Panel web (servidor/web)
DMJ_WEB_HOST=0.0.0.0
DMJ_WEB_PORT=8999
DMJ_WEB_DIST=/home/DMujeres-Tracking/panel/dist

# Recuperación por notificaciones (servidor/recuperacion)
DMJ_FCM_CREDENCIAL=/ruta/a/firebase-adminsdk.json
DMJ_RECUPERACION_INTERVALO=60
DMJ_RECUPERACION_SILENCIO_MIN=15
DMJ_RECUPERACION_COOLDOWN=60
DMJ_RECUPERACION_MAX_HORA=5
# 1 = hace todo menos mandar la notificación.
DMJ_RECUPERACION_DRY_RUN=0
