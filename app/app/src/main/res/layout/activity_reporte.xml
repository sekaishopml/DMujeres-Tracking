<?xml version="1.0" encoding="utf-8"?>
<!-- Mi reporte: diario, semanal o mensual. Arriba el período, en medio el
     resumen, los días y la planilla del día elegido; abajo las acciones.
     Sin ventanas emergentes: los avisos van en la línea de estado. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/rep_volver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/journey_confirm_cancel"
            android:src="@drawable/ds_ic_back"
            android:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rep_titulo"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rep_subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Período: control segmentado. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/ds_surface"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/rep_dia"
            style="@style/RepSegmento"
            android:text="@string/rep_dia" />

        <TextView
            android:id="@+id/rep_semana"
            style="@style/RepSegmento"
            android:text="@string/rep_semana" />

        <TextView
            android:id="@+id/rep_mes"
            style="@style/RepSegmento"
            android:text="@string/rep_mes" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/rep_anterior"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/rep_anterior_desc"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/navy_700"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/rep_rango"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rep_siguiente"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/rep_siguiente_desc"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/navy_700"
            android:textSize="26sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/rep_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <!-- Lo arma VistaReporte: resumen, días y la planilla del día. -->
        <LinearLayout
            android:id="@+id/rep_vista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Acciones: correo, descargas y envío. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/rep_correo_fila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="36dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rep_correo_texto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/rep_correo_cambiar"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="2dp"
                android:text="@string/rep_cambiar"
                android:textColor="@color/navy_700"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rep_correo_editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/rep_correo_campo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:autofillHints="emailAddress"
                android:background="@drawable/ds_field"
                android:hint="@string/rep_correo_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="yes"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/rep_correo_guardar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ds_boton_marino"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/debug_save"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rep_excel"
                style="@style/RepDescarga"
                android:layout_marginEnd="8dp"
                android:text="@string/rep_excel" />

            <TextView
                android:id="@+id/rep_imagen"
                style="@style/RepDescarga"
                android:text="@string/rep_imagen" />
        </LinearLayout>

        <TextView
            android:id="@+id/rep_enviar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/ds_button_primary"
            android:gravity="center"
            android:text="@string/rep_enviar"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rep_estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:minHeight="18dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
