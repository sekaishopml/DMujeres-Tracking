<?xml version="1.0" encoding="utf-8"?>
<!-- Bienvenida: texto sobrio y los tres pasos numerados, sin tarjetas de
     adorno. Todo en blanco y marino; el magenta solo marca el avance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/welcome_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_overline"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/welcome_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/welcome_hero_text"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/welcome_steps_label"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/ds_surface"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <include android:id="@+id/welcome_step1" layout="@layout/onboarding_feature_row" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />

        <include android:id="@+id/welcome_step2" layout="@layout/onboarding_feature_row" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />

        <include android:id="@+id/welcome_step3" layout="@layout/onboarding_feature_row" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/welcome_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:text="@string/welcome_privacy"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp" />

</LinearLayout>
