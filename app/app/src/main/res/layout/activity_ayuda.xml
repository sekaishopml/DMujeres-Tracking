<?xml version="1.0" encoding="utf-8"?>
<!-- Guía breve de uso: pasos numerados; se abre desde el signo "?" del inicio. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <!-- Cabecera magenta: volver, título y para qué sirve la guía. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ds_ayuda_cabecera"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <ImageButton
            android:id="@+id/ayuda_volver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/journey_confirm_cancel"
            android:src="@drawable/ds_ic_back"
            android:tint="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:text="@string/ayuda_titulo"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:paddingStart="14dp"
            android:text="@string/ayuda_intro"
            android:textColor="#E6FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/ayuda_pasos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:text="@string/ayuda_cierre"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
