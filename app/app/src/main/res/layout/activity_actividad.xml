<?xml version="1.0" encoding="utf-8"?>
<!-- Agregar o editar una actividad del cronograma (pantalla completa, no
     popup): tipo, horario (Desde/Hasta con AM/PM y aviso de cruces), lugar y
     nota. Guardar queda siempre a la vista, sobre el teclado. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/act_volver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/crono_cancelar"
            android:src="@drawable/ds_ic_back"
            android:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/act_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/act_fecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/act_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tipo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ds_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/CronoEtiqueta"
                    android:text="@string/crono_que_actividad" />

                <LinearLayout
                    android:id="@+id/act_tipos_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/act_tipos_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- Horario -->
            <LinearLayout
                android:id="@+id/act_horario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/ds_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CronoEtiqueta"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/crono_horario" />

                    <TextView
                        android:id="@+id/act_todo_dia"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:text="@string/crono_todo_el_dia"
                        android:textColor="@color/primary"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/crono_desde"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/act_desde"
                            style="@style/CronoCampoHora"
                            android:imeOptions="actionNext"
                            android:nextFocusForward="@+id/act_hasta" />

                        <LinearLayout style="@style/CronoAmPmFila">

                            <TextView
                                android:id="@+id/act_desde_am"
                                style="@style/CronoAmPm"
                                android:layout_marginEnd="4dp"
                                android:text="AM" />

                            <TextView
                                android:id="@+id/act_desde_pm"
                                style="@style/CronoAmPm"
                                android:text="PM" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="22dp"
                        android:gravity="center"
                        android:text="→"
                        android:textColor="@color/text_tertiary"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/crono_hasta"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/act_hasta"
                            style="@style/CronoCampoHora"
                            android:imeOptions="actionDone" />

                        <LinearLayout style="@style/CronoAmPmFila">

                            <TextView
                                android:id="@+id/act_hasta_am"
                                style="@style/CronoAmPm"
                                android:layout_marginEnd="4dp"
                                android:text="AM" />

                            <TextView
                                android:id="@+id/act_hasta_pm"
                                style="@style/CronoAmPm"
                                android:text="PM" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Lo que se va a guardar, en palabras: "1 h 30 min · 9:00 – 10:30 a. m." -->
                <TextView
                    android:id="@+id/act_resumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Cruce con otra actividad del día y cómo se acomoda. -->
                <LinearLayout
                    android:id="@+id/act_cruce"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ds_aviso"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/act_cruce_titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/warn"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/act_cruce_texto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/act_cruce_accion"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/ds_button_outline"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Lugar (visita y novedad) -->
            <LinearLayout
                android:id="@+id/act_lugar_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/ds_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/CronoEtiqueta"
                    android:text="@string/crono_lugar" />

                <AutoCompleteTextView
                    android:id="@+id/act_lugar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/ds_field"
                    android:completionThreshold="1"
                    android:hint="@string/crono_lugar_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <HorizontalScrollView
                    android:id="@+id/act_lugares_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/act_lugares"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Nota -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/ds_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/act_nota_label"
                    style="@style/CronoEtiqueta"
                    android:text="@string/crono_nota" />

                <EditText
                    android:id="@+id/act_nota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/ds_field"
                    android:gravity="top"
                    android:hint="@string/crono_nota_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:minHeight="72dp"
                    android:padding="14dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/act_eliminar"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/crono_eliminar_actividad"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/act_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/act_guardar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/ds_button_primary"
            android:stateListAnimator="@null"
            android:text="@string/crono_guardar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
