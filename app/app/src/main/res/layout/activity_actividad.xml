<?xml version="1.0" encoding="utf-8"?>
<!-- Agregar o editar una actividad (pantalla completa). Cada tarjeta responde
     una pregunta: qué, cuándo, dónde y la nota. Abajo queda siempre a la
     vista, sobre el teclado, lo que se va a guardar y el botón. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/act_volver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/crono_cancelar"
            android:src="@drawable/ds_ic_back"
            android:tint="@color/navy" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/act_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/act_fecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/act_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/act_contenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Qué: una ficha por tipo, con para qué sirve. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ds_surface"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/CronoEtiqueta"
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:text="@string/crono_que" />

                <LinearLayout
                    android:id="@+id/act_tipos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <!-- Tipo ya elegido: una sola ficha, con Cambiar para volver a la lista. -->
                <LinearLayout
                    android:id="@+id/act_tipo_elegido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/act_tipo_elegido_nombre"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/act_tipo_cambiar"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/crono_cambiar"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Para qué sirve el tipo elegido. -->
                <TextView
                    android:id="@+id/act_tipo_ayuda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Cuándo: ahora o con horario; horas sugeridas y duraciones a un toque. -->
            <LinearLayout
                android:id="@+id/act_horario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/ds_surface"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/CronoEtiqueta"
                    android:text="@string/crono_cuando" />

                <!-- Solo al agregar una de hoy: empezarla ya o dejarla programada. -->
                <LinearLayout
                    android:id="@+id/act_modo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/ds_pista"
                    android:orientation="horizontal"
                    android:padding="3dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/act_modo_ahora"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/ds_segmento"
                        android:gravity="center"
                        android:text="@string/crono_modo_ahora"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/act_modo_programar"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/ds_segmento"
                        android:gravity="center"
                        android:text="@string/crono_modo_programar"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Con horario: lo que la app propone, las horas y la duración. -->
                <LinearLayout
                    android:id="@+id/act_horas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <HorizontalScrollView
                        android:id="@+id/act_sugerencias_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/act_sugerencias"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/crono_desde"
                                android:textColor="@color/text_secondary"
                                android:textSize="11.5sp" />

                            <EditText
                                android:id="@+id/act_desde"
                                style="@style/CronoCampoHora"
                                android:imeOptions="actionNext"
                                android:nextFocusForward="@+id/act_hasta" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="20dp"
                            android:layout_height="44dp"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:text="–"
                            android:textColor="@color/text_tertiary"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/crono_hasta"
                                android:textColor="@color/text_secondary"
                                android:textSize="11.5sp" />

                            <EditText
                                android:id="@+id/act_hasta"
                                style="@style/CronoCampoHora"
                                android:hint="@string/crono_hasta_hint"
                                android:imeOptions="actionDone" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Rueda de hora y minuto: se abre al tocar Desde o Hasta. -->
                    <com.dmujeres.app.cronograma.RuedaHora
                        android:id="@+id/act_rueda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <!-- Duración a un toque: mueve la hora de fin. -->
                    <LinearLayout
                        android:id="@+id/act_duraciones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- Cruce con otra actividad del día y cómo se acomoda. -->
                <LinearLayout
                    android:id="@+id/act_cruce"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ds_aviso"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/act_cruce_titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/warn"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/act_cruce_texto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/act_cruce_accion"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/ds_button_outline"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Dónde (visita y novedad) y nota, en una sola tarjeta. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/ds_surface"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/act_lugar_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CronoEtiqueta"
                        android:text="@string/crono_donde" />

                    <EditText
                        android:id="@+id/act_lugar"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/ds_field"
                        android:hint="@string/crono_lugar_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/act_nota_label"
                    style="@style/CronoEtiqueta"
                    android:text="@string/crono_nota" />

                <EditText
                    android:id="@+id/act_nota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/ds_field"
                    android:gravity="center_vertical"
                    android:hint="@string/crono_nota_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="2"
                    android:minHeight="44dp"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <HorizontalScrollView
                    android:id="@+id/act_notas_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/act_notas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <TextView
                android:id="@+id/act_eliminar"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/crono_eliminar_actividad"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- Lo que se va a guardar, en palabras, o lo que falta para poder guardar. -->
        <TextView
            android:id="@+id/act_resumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/ds_sugerencia"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/act_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/act_guardar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/ds_button_primary"
            android:stateListAnimator="@null"
            android:text="@string/crono_guardar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
