<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Reposo: fondo blanco con borde azul marino (la palabra ACTUALIZAR) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="2dp" android:color="@color/navy" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Avance: se rellena de azul de izquierda a derecha según los pasos -->
    <item android:id="@+id/progress_fill">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/navy" />
                <corners android:radius="14dp" />
            </shape>
        </clip>
    </item>
</layer-list>
